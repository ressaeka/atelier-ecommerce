PORT=4000
HOST=localhost
NODE_ENV=development

# JWT
JWT_SECRET=your_jwt_secret_min_32_characters_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_SECRET=your_jwt_reset_secret_min_32_chars

# Database & Redis
DATABASE_URL="postgresql://postgres:admin@localhost:5432/ecommerce-api"
REDIS_URL="redis://localhost:6379"

# Email & OTP
RESEND_API_KEY=re_your_resend_api_key
MAIL_FROM=onboarding@resend.dev
OTP_PEPPER=your_otp_pepper_min_16_characters

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
GOOGLE_FRONTEND_URL=http://localhost:5173

# Midtrans Configuration
MIDTRANS_MERCHANT_ID=your_midtrans_merchant_id
MIDTRANS_CLIENT_KEY=your_midtrans_client_key
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_IS_PRODUCTION=false

# URLs (Bedakan browser return vs webhook server-to-server)
# A. Frontend return URL untuk Snap callback (browser user setelah bayar)
FRONTEND_URL=http://localhost:5173

# B. Notification URL untuk webhook Midtrans -> Backend (server-to-server POST via ngrok saat dev)
# Contoh: https://your-ngrok-domain.ngrok-free.dev/api/v1/payment/notification
MIDTRANS_NOTIFICATION_URL=https://your-ngrok-domain.ngrok-free.dev/api/v1/payment/notification
